{
  "expo": {
    "name": "T-Pay",
    "slug": "tpay-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tpay.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050608"
      },
      "package": "com.tpay.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050608"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "e8ea861d-7af4-4540-8bf0-88a8a90e1459"
      }
    },
    "owner": "olayiwola206"
  }
}
