{
  "expo": {
    "name": "T-Pay",
    "slug": "tpay-mobile",
    "scheme": "tpay",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tpay.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#050608"
      },
      "package": "com.tpay.mobile",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050608",
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "T-Pay uses Face ID to open the app."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e8ea861d-7af4-4540-8bf0-88a8a90e1459"
      }
    },
    "owner": "olayiwola206",
    "icon": "./assets/brand/icon.png"
  }
}
