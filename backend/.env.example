# Local Postgres from docker-compose.yml. Use the Render connection string when deployed.
DATABASE_URL=postgres://tpay:tpay@localhost:5433/tpay

# Create both with: npm run keys:root
ROOT_PRIVATE_KEY=
ROOT_PUBLIC_KEY=

PORT=4000

# PayPal sandbox app credentials: developer.paypal.com > Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# From the webhook you add in the PayPal app, once the backend has a public URL.
# Until it is set, every webhook is refused.
PAYPAL_WEBHOOK_ID=

# Address PayPal sends the person back to. Use the Render URL when deployed.
PUBLIC_BASE_URL=http://localhost:4000

# Fixed demo rate, naira per US dollar.
FX_RATE=1500.00

# Optional. A sandbox personal account email, used by npm run paypal:proof to test one payout.
PAYPAL_PROOF_PAYOUT_EMAIL=

# Optional. Google AI Studio key for the voice assistant (POST /api/assistant/interpret).
# Without it the endpoint returns AI_UNAVAILABLE and the app uses its offline assistant.
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=
